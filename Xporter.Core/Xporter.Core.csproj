<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>$(VersionPrefix)</Version>
    <Authors>Dimitris Grevenos</Authors>
    <Company />
    <PackageTags>Xporter, export, spreadsheet, xlsx, excel, exporting, easy-export</PackageTags>
    <Description>"Xporter" allows users to export Spreadsheet files easily from either any object type or list of properties as a source, using pre-existing .xlsx files as Templates.</Description>
    <PackageProjectUrl>https://github.com/dimgrev/Xporter</PackageProjectUrl>
    <PackageIcon>XporterIcon164.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>Xporter Library</Product>
    <Copyright>@2026, dimgrev</Copyright>
    <RepositoryUrl>https://github.com/dimgrev/Xporter</RepositoryUrl>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageReleaseNotes>Updated (NEW) version 1.0.0
- Added the ability to handle more easily same type of objects
- Optimised code</PackageReleaseNotes>
    <Title>Xporter</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ReadMe.txt">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="XporterIcon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="XporterIcon164.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="XporterIcon2.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
